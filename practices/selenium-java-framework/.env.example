# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Base URL of the application under test
BASE_URL=https://your-app-url.com

# Environment (staging | production | dev)
ENV=staging

# ===========================================
# BROWSER CONFIGURATION
# ===========================================

# Browser: chrome | firefox | edge | safari
BROWSER=chrome

# Run headless (true | false) — set true for CI
HEADLESS=false

# Browser window size
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# ===========================================
# TIMEOUTS (in seconds)
# ===========================================

# Implicit wait
IMPLICIT_WAIT=10

# Explicit wait / FluentWait timeout
EXPLICIT_WAIT=30

# Page load timeout
PAGE_LOAD_TIMEOUT=60

# ===========================================
# TEST CREDENTIALS (use GitHub Secrets in CI)
# ===========================================

# Test user credentials — NEVER hardcode real passwords here
TEST_EMAIL=your-test-email@example.com
TEST_PASSWORD=your-test-password

# Admin credentials (if needed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password

# ===========================================
# ALLURE REPORT
# ===========================================

ALLURE_RESULTS_DIR=target/allure-results

# ===========================================
# SCREENSHOT
# ===========================================

SCREENSHOT_DIR=target/screenshots
